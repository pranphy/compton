/compton/setgeofile geometry/compton/ComptonGeometry.gdml
/compton/parallel/setfile geometry/compton/ComptonParallel.gdml


/physics_lists/em/SyncRadiation true
#/compton/physlist/optical/enable
#/compton/physlist/parallel/enable
#/compton/physlist/synchrotron/enable

/run/verbose 0
#/tracking/verbose 3

/compton/field/add 1 map_directory/mgf/dipole_magnetic_field_20_1.txt
/compton/field/add 2 map_directory/mgf/dipole_magnetic_field_20_2.txt
/compton/field/add 3 map_directory/mgf/dipole_magnetic_field_20_3.txt
/compton/field/add 4 map_directory/mgf/dipole_magnetic_field_20_4.txt

/run/initialize

/compton/printgeometry false

/compton/evgen/set beam
/compton/evgen/beam/beamene 11.0 GeV
/compton/evgen/beam/beamcurr 65 microampere
/compton/evgen/beam/origin 0  215.49 -9849.76 mm
/compton/evgen/beam/xspread 0 um
/compton/evgen/beam/yspread 0 um
/compton/evgen/beam/rasx 0 um
/compton/evgen/beam/rasy 0 um




#/compton/evgen/beamPolarization +L

#/compton/evgen/set laser
#/compton/evgen/laser/origin 0  215.49 0 mm
#/compton/evgen/laser/energy 1 MeV


/compton/SD/disable_all
/compton/SD/enable 41
/compton/SD/detect boundaryhits 41

/compton/SD/enable 13
/compton/SD/detect boundaryhits 13

/compton/SD/enable 16
/compton/SD/detect boundaryhits 16

/compton/SD/enable 15
/compton/SD/detect boundaryhits 15

#/process/list

/compton/seed 42
/compton/interval 10

/compton/filename /tmp/f_23_again.root

/run/beamOn 1000

