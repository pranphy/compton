/compton/setgeofile geometry/compton/ComptonGeometry.gdml
/compton/parallel/setfile geometry/compton/ComptonParallel.gdml

/compton/physlist/parallel/enable
/physics_lists/em/SyncRadiation true

/run/initialize
/compton/printgeometry false
/run/verbose 0
#/tracking/verbose 3

/compton/addfield map_directory/dipole_magnetic_field_19_1.txt
/compton/addfield map_directory/dipole_magnetic_field_19_2.txt
/compton/addfield map_directory/dipole_magnetic_field_19_3.txt
/compton/addfield map_directory/dipole_magnetic_field_19_4.txt


/compton/evgen/beam/origin 0  215.49 -8249.76 mm
/compton/evgen/beam/xspread 60 um
/compton/evgen/beam/yspread 60 um
/compton/evgen/beam/rasx 0 um
/compton/evgen/beam/rasy 0 um
/compton/evgen/beam/corrx 0
/compton/evgen/beam/corry 0


/compton/beamene 11 GeV
/compton/beamcurr 65 microampere


/compton/evgen/set beam

/compton/evgen/beamPolarization +L
/compton/field/equationtype 2
/compton/field/steppertype 2


/compton/SD/disable_all
/compton/SD/enable 17
/compton/SD/detect lowenergyneutral 17
/compton/SD/detect secondaries 17
/compton/SD/detect boundaryhits 17


/process/list

/compton/seed 112135637
/compton/filename output/a_test_file_with_0.5Mevents_beam_f19.root

/run/beamOn 500000

